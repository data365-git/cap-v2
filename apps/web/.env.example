# cap-v2 (data365 meeting-transcription platform) — environment variables
#
# Copy to `.env.local` for local dev, or set these in your host (Railway, etc.).
# Validation is via @cap/env (zod). Vars marked REQUIRED must be present or the
# build/runtime throws "Invalid environment variables". Everything else is
# optional; unset optional integrations are simply dormant.
#
# For CI build-checks / typecheck WITHOUT secrets, set SKIP_ENV_VALIDATION=true
# (the produced build is NOT deployable — NEXT_PUBLIC_WEB_URL is inlined at build).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will not build/boot without these
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:pass@host:3306/cap"        # MySQL connection string
WEB_URL="https://your-domain.example"                 # Public URL of the server
NEXT_PUBLIC_WEB_URL="https://your-domain.example"      # Client-side URL (falls back to WEB_URL at build)
NEXTAUTH_URL="https://your-domain.example"             # Same as WEB_URL
NEXTAUTH_SECRET="<32-byte base64>"                     # openssl rand -base64 32
INVITE_TOKEN_SECRET="<random secret>"                  # Signs org invite tokens
NODE_ENV="production"

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO). Bucket+region
# required; credentials optional if using instance roles. See R2 block below for
# the R2 shortcut that auto-maps onto these.
CAP_AWS_BUCKET="your-bucket"
CAP_AWS_REGION="auto"                                  # "auto" for R2
CAP_AWS_ACCESS_KEY=""
CAP_AWS_SECRET_KEY=""
S3_PUBLIC_ENDPOINT=""                                  # e.g. https://<acct>.r2.cloudflarestorage.com
S3_INTERNAL_ENDPOINT=""
S3_PATH_STYLE="true"                                   # true for R2/MinIO
CAP_AWS_BUCKET_URL=""                                  # public/CDN URL of the bucket
DATABASE_ENCRYPTION_KEY=""                             # 32-byte hex; encrypts stored S3 creds

# ─────────────────────────────────────────────────────────────────────────────
# AI — functionally required for THIS product (transcription + summaries).
# Schema-optional, but transcription/AI won't work without at least GEMINI+GROQ.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""            # Google Gemini — transcription + AI analysis (paid tier)
GROQ_API_KEY=""              # Groq — AI summaries + transcript translation (VTT)

# ─────────────────────────────────────────────────────────────────────────────
# AI — optional / opt-in features (dormant until set)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY_FREE=""       # Free Gemini key, used FIRST only in opt-in cheap mode
AI_CHEAP_PATIENCE_MINUTES="240"  # cheap-mode wait before auto-continuing on paid (default 4h)
ELEVENLABS_API_KEY=""        # ElevenLabs Scribe — opt-in word-level timestamp refinement
ANTHROPIC_API_KEY=""         # (optional) AI chat
OPENAI_API_KEY=""            # (optional) alternate AI summaries
REPLICATE_API_TOKEN=""       # (optional) audio enhancement

# ─────────────────────────────────────────────────────────────────────────────
# Auth (Google OAuth login) — optional
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CAP_ALLOWED_SIGNUP_DOMAINS=""   # comma-separated allowlist, e.g. data365.online
INITIAL_ADMIN_EMAIL=""          # seed script only
INITIAL_ADMIN_PASSWORD=""       # seed script only

# ─────────────────────────────────────────────────────────────────────────────
# Cron + ops (cap-v2 additions) — optional, dormant when unset
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=""                  # Bearer token for /api/cron/* (recover-stale, reconcile-storage, poll-batch-jobs). Unset = crons no-op.
TELEGRAM_BOT_TOKEN=""           # ops/uptime alerts
TELEGRAM_ALERT_CHAT_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 shortcut — set these and they auto-map onto CAP_AWS_*/S3_* above
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Settings — optional
# ─────────────────────────────────────────────────────────────────────────────
CAP_VIDEOS_DEFAULT_PUBLIC="true"
NEXT_PUBLIC_IS_CAP=""           # leave unset for self-host (Cap Cloud-only features)

# ─────────────────────────────────────────────────────────────────────────────
# Cap Cloud / analytics integrations — NOT needed for data365 self-host (dormant)
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, DISCORD_*_WEBHOOK_URL, TINYBIRD_*,
# VERCEL_*, POSTHOG_*, DUB_API_KEY, SUPERMEMORY_*  — all optional, leave unset.
# ─────────────────────────────────────────────────────────────────────────────
